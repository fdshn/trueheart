# Hạ tầng dev (docker-compose.yml đọc các biến này)
POSTGRES_USER=chantam
POSTGRES_PASSWORD=chantam
POSTGRES_DB=chantam
# Cố ý KHÔNG dùng 5432/6379: máy dev thường đã có sẵn PostgreSQL/Redis cài cục bộ,
# và cái cài sẵn sẽ thắng kết nối, gây lỗi xác thực rất khó đoán.
