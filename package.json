{
  "name": "@chantam/services",
  "description": "Monorepo dịch vụ nền tảng Chân Tâm (True Heart)",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "kernel/*",
    "system/*",
    "suites/*/*/*"
  ],
  "scripts": {
    "build": "lerna run build --concurrency 1",
    "start": "lerna run start",
    "dev": "lerna run dev --parallel",
    "test": "lerna run test --concurrency 1 --no-bail",
    "format": "prettier --write \"{kernel,system,suites}/**/src/**/*.ts\"",
    "lint": "eslint \"{kernel,system,suites}/**/src/**/*.ts\" --fix",
    "clean": "lerna run clean --no-bail",
    "rebuild": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "cross-env": "^10.1.0",
    "cross-var": "^1.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "lerna": "^8.1.9",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "prettier-plugin-organize-imports": "^4.1.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
