# Chép thành .env trên server rồi điền giá trị thật.
# KHÔNG commit file .env.

# Bắt buộc — đặt mật khẩu mạnh, không dùng lại giá trị của môi trường dev
POSTGRES_USER=chantam
POSTGRES_PASSWORD=THAY_BANG_MAT_KHAU_MANH
POSTGRES_DB=chantam

# Workflow deploy tự ghi đè dòng này mỗi lần triển khai.
# Giá trị ban đầu chỉ để `docker compose config` không báo lỗi.
IMAGE=ghcr.io/fdshn/trueheart/core:staging

# Xác thực — BẮT BUỘC, tối thiểu 32 ký tự. Sinh bằng: openssl rand -base64 48
# KHÔNG dùng lại giá trị của môi trường dev.
JWT_SECRET=THAY_BANG_KHOA_NGAU_NHIEN_TOI_THIEU_32_KY_TU

LOG_LEVEL=info
# Core chỉ bind loopback; host Nginx proxy HTTPS về cổng này. Staging trên server
# dev hiện dùng 8080, production server thật dùng 8085. Giá trị 3000 phù hợp
# khi chạy một stack độc lập/local.
CORE_PORT=3000
GEO_JITTER_RADIUS_METERS=300

# Hạn dùng mã OTP quên mật khẩu, tính bằng giây (120-1800)
OTP_TTL_SECONDS=300

# ─────────────────────────────────────────────────────────────────────────────
# An ninh theo nguồn gọi
#
# ĐẶT `true` ở staging và production, vì cả hai đều có host Nginx đứng trước.
# Để `false` ở đó thì mọi request mang IP của Nginx, nên bốn cái trần dưới đây
# dồn hết vào một xô: một người lụt là cả hệ bị 429. Ngược lại, bật `true` khi
# KHÔNG có proxy thì ai cũng tự khai `X-Forwarded-For` và bốn trần đó thành vô
# hiệu. Sai hướng nào cũng lặng lẽ, nên đây là dòng phải đặt đúng tay.
TRUST_PROXY=true

# Trần gọi chung mọi endpoint, theo IP mỗi phút. 600 = 10 lượt/giây.
GLOBAL_RATE_LIMIT_PER_MINUTE=600

# Trần theo tài khoản, và trần theo IP bù cho nó: rải một mật khẩu phổ biến qua
# mười nghìn username thì mỗi tài khoản chỉ sai một lần.
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900
MAX_LOGIN_ATTEMPTS_PER_IP=30

# Tài khoản mới đẻ ra điểm qua referral và affiliate, nên tạo hàng loạt là một
# đường gian lận chứ không chỉ là rác.
MAX_REGISTRATIONS_PER_IP=5
REGISTRATION_WINDOW_SECONDS=3600

# Token. Để mặc định nếu không có lý do cụ thể để đổi.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

# Ô chọn "Servers" của Swagger. Khai CHÍNH môi trường này và chỉ nó:
#   API_SERVERS=Staging=https://api-staging.example.com
# Liệt kê môi trường khác là mời người mở tài liệu production bấm "Try it out"
# nhầm sang staging và ngược lại.
#
# Để trống thì Swagger chỉ còn một mục localhost — vô dụng khi đọc tài liệu từ
# máy khác, vì localhost trong trình duyệt họ là máy của họ.
# `bootstrap.sh <môi-trường> <hostname>` tự điền dòng này.
API_SERVERS=

# CẢNH BÁO: chưa có nhà cung cấp email/SMS/Zalo ZNS nào được cắm vào.
# Ở NODE_ENV=production, chức năng quên mật khẩu TỰ TẮT: mọi yêu cầu đặt lại
# mật khẩu trả về kênh ADMIN_SUPPORT, không mã nào được ghi ra log. Service vẫn
# khởi động bình thường và ghi một dòng log mức ERROR lúc khởi động.
# Xem docs/plan/ASSUMPTIONS.md.


# Cloudflare R2 (S3-compatible). Khai thật bằng server .env/GitHub Environment,
# không commit credential. Không có provider thì avatar presign endpoint fail closed.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=

# OTP email provider (config-only, chưa bật gửi). Khai From đã được provider
# verify sau này; không bỏ vendor API key vào repo/.env.example.
OTP_EMAIL_FROM_ADDRESS=
OTP_EMAIL_FROM_NAME=Chân Tâm

# ─────────────────────────────────────────────────────────────────────────────
# Hai khoá bí mật — cả hai hỏng IM LẶNG khi bỏ trống

# Mã hoá secret do Admin cấu hình (mật khẩu SMTP, API key Zalo...).
# 32 byte base64, sinh bằng: openssl rand -base64 32
# Khoá nằm trong .env này, ciphertext nằm trong database — nên đọc được bản dump
# cũng chưa lấy được mật khẩu. Bỏ trống thì KHÔNG lưu được secret nào: Admin bấm
# lưu cấu hình SMTP và nó fail closed.
CONFIG_ENCRYPTION_KEY=

# Push FCM (F44) — CHƯA CÓ KHOÁ, Bên A sẽ cung cấp sau.
#
# Service account JSON của dự án Firebase, mã hoá base64:
#   base64 -w0 service-account.json
#
# Khi trống, hệ dùng LoggingPushSender: fail-closed ở production, không bao giờ
# giả vờ đã gửi. Thông báo TRONG APP vẫn ghi và hiển thị đầy đủ — mất đường đẩy
# không được làm mất thông báo. Dán khoá vào đây là push chạy, KHÔNG cần sửa mã.
FCM_SERVICE_ACCOUNT_BASE64=

# Băm số điện thoại trong bảng `verified_phones`, bảng cố ý sống lâu hơn tài khoản.
# 32 byte base64, sinh bằng: openssl rand -base64 32
# Bỏ trống thì vẫn băm nhưng KHÔNG có khoá, và chống trùng vẫn chạy nên không gì
# đỏ. Cái mất: không gian số điện thoại Việt Nam đủ nhỏ để kẻ đọc được database dò
# ngược hết bảng băm trong thời gian ngắn.
PHONE_HASH_PEPPER=

# ─────────────────────────────────────────────────────────────────────────────

# Gốc URL web công khai, dựng link chia sẻ hồ sơ (`/u/<username>`). Bỏ trống thì
# API trả shareUrl = null — trên production đó là một tính năng im lặng không chạy.
WEB_PUBLIC_BASE_URL=

# Chỉ dùng MỘT LẦN để cấp SUPER_ADMIN cho một tài khoản đã tồn tại, rồi XOÁ giá
# trị đi. Để nguyên là mỗi lần khởi động lại cấp quyền cao nhất cho username đó.
# Không có dòng này thì môi trường mới không có đường nào tạo admin đầu tiên ngoài
# sửa database bằng tay.
ADMIN_BOOTSTRAP_USERNAMES=

# ─────────────────────────────────────────────────────────────────────────────
# Cảnh báo cron. KHÔNG đọc từ file này — cron đọc môi trường của chính nó, nên
# đặt hai dòng này trong crontab (xem deploy/cron/README.md), không phải ở đây.
#
#   CHANTAM_CRON_ALERT_URL=https://hooks.slack.com/services/xxx
#   CHANTAM_CRON_ALERT_CHAT_ID=       # chỉ khi URL là Telegram
