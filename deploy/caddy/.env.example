# Chép thành .env trong cùng thư mục rồi điền tên miền thật.
#
# Tên miền phải ĐÃ trỏ A record về IP máy này TRƯỚC khi khởi động Caddy.
# Caddy xin chứng chỉ ngay lúc chạy; tên miền chưa trỏ thì Let's Encrypt từ chối,
# và nó giới hạn 5 lần thất bại mỗi giờ cho cùng một tên miền.

STAGING_DOMAIN=api-staging.chantam.vn
PRODUCTION_DOMAIN=api.chantam.vn

# Cổng mà mỗi stack bind trên 127.0.0.1. Khớp với CORE_PORT trong .env của từng
# môi trường. Đổi ở đây thì phải đổi cả bên kia.
STAGING_PORT=3000
PRODUCTION_PORT=3001
