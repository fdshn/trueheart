# Host Nginx template — Chân Tâm staging + production
#
# Không chạy Nginx bằng Docker. VPS đã có Nginx/Certbot giữ cổng 80/443; thêm
# file này vào /etc/nginx/sites-available/ rồi symlink sang sites-enabled/.
#
# CÁCH DÙNG:
#   1. Thay hai hostname + đường dẫn certificate bằng tên miền thật.
#   2. Bỏ block production nếu server này chỉ chạy staging.
#   3. sudo nginx -t && sudo systemctl reload nginx
#   4. Lần đầu chỉ cài HTTP block, chạy Certbot; Certbot tự thêm block HTTPS.
#      Hoặc dùng trực tiếp block HTTPS dưới đây nếu certificate đã có.
#
# Cổng Core chỉ bind loopback:
#   staging    -> 127.0.0.1:8080
#   production -> 127.0.0.1:8085
# Không đổi upstream thành IP Docker hay publish Core ra Internet.

# ─────────────────────────────────────────────────────────────────────────────
# STAGING — Swagger mở để mobile/web thử API

server {
    listen 80;
    listen [::]:80;
    server_name api-staging.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # `listen ... http2` là cú pháp CŨ, và Nginx >= 1.25 báo deprecated cho nó.
    # GIỮ NGUYÊN, đừng đổi sang `http2 on;`: host chạy Nginx của gói Ubuntu
    # (22.04 → 1.18, 24.04 → 1.24), và `http2 on` chưa tồn tại ở những bản đó nên
    # đổi là Nginx KHÔNG khởi động. Một dòng cảnh báo lúc reload rẻ hơn nhiều so
    # với một host không lên được.
    #
    # `scripts/test-nginx-config.sh` chạy `nginx -t` trên ảnh 1.27 nên cảnh báo đó
    # sẽ hiện ở đó — nó là cảnh báo mong đợi, không phải lỗi.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api-staging.example.com;

    # Certbot quản lý hai đường dẫn này. Đổi example.com thành domain thật.
    ssl_certificate /etc/letsencrypt/live/api-staging.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api-staging.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # HSTS chỉ gửi qua HTTPS. Đừng bật includeSubDomains nếu subdomain khác của
    # organisation chưa hỗ trợ HTTPS — browser sẽ khoá chúng suốt 1 năm.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    server_tokens off;

    gzip on;
    gzip_types application/json application/javascript text/css text/plain;

    # Swagger là tài liệu nội bộ: khoá cả UI, OpenAPI JSON và asset bên dưới
    # /docs/. Không chỉ khoá /docs, vì /docs/json vẫn phơi toàn bộ API.
    location = /docs {
        auth_basic "Chân Tâm API documentation";
        auth_basic_user_file /etc/nginx/chantam-docs-staging.htpasswd;

        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/proxy_params;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location ^~ /docs/ {
        auth_basic "Chân Tâm API documentation";
        auth_basic_user_file /etc/nginx/chantam-docs-staging.htpasswd;

        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/proxy_params;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # ── Chặn tốc độ ─────────────────────────────────────────────────────────
    #
    # Zone khai ở `conf.d/chantam-ratelimit.conf` (xem file đó để biết vì sao mọi
    # ngưỡng ở đây CAO HƠN trần của app một cách cố ý). Thiếu file đó thì Nginx
    # không khởi động vì zone chưa khai báo — hỏng ỒN ÀO, đúng ý.

    # Đường xác thực đi zone chặt hơn: đây là nơi người ta dò mật khẩu.
    location ^~ /api/v1/auth/ {
        limit_req zone=chantam_auth burst=10 nodelay;
        limit_conn chantam_conn 100;

        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/proxy_params;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Socket.io cho chat. KHÔNG đặt limit_req ở đây.
    #
    # Khi WebSocket không nâng cấp được, Socket.io rơi về long-polling và sinh
    # RẤT nhiều lượt request hoàn toàn hợp lệ. Một `limit_req` đặt hồn nhiên sẽ
    # chẹn đúng chat chứ không chẹn kẻ lụt — và người dùng chỉ thấy tin nhắn
    # không tới, không thấy lý do.
    location ^~ /socket.io/ {
        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/proxy_params;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Idle của WebSocket dài hơn REST rất nhiều: một kết nối đang CHỜ tin
        # nhắn thì không có byte nào chạy qua. 60s như REST sẽ cắt nó mỗi phút,
        # và client phải nối lại liên tục.
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        limit_req zone=chantam_general burst=60 nodelay;
        limit_conn chantam_conn 100;

        proxy_pass http://127.0.0.1:8080;
        include /etc/nginx/proxy_params;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # Không khai Upgrade/Connection ở đây: khối này phục vụ REST. WebSocket
        # của chat đi qua `location ^~ /socket.io/` ở trên.

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        client_max_body_size 15m;
    }
}

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION — Swagger bị chặn để không phơi hình dạng API/mã lỗi cho Internet

server {
    listen 80;
    listen [::]:80;
    server_name api.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # `listen ... http2` là cú pháp CŨ, và Nginx >= 1.25 báo deprecated cho nó.
    # GIỮ NGUYÊN, đừng đổi sang `http2 on;`: host chạy Nginx của gói Ubuntu
    # (22.04 → 1.18, 24.04 → 1.24), và `http2 on` chưa tồn tại ở những bản đó nên
    # đổi là Nginx KHÔNG khởi động. Một dòng cảnh báo lúc reload rẻ hơn nhiều so
    # với một host không lên được.
    #
    # `scripts/test-nginx-config.sh` chạy `nginx -t` trên ảnh 1.27 nên cảnh báo đó
    # sẽ hiện ở đó — nó là cảnh báo mong đợi, không phải lỗi.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.example.com;

    ssl_certificate /etc/letsencrypt/live/api.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.example.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    server_tokens off;

    gzip on;
    gzip_types application/json application/javascript text/css text/plain;

    # Swagger UI, asset và OpenAPI JSON đều 404. /health vẫn mở vì GitHub CD
    # dùng HEALTH_URL/health làm cổng kiểm sau deploy.
    location = /docs { return 404; }
    location ^~ /docs/ { return 404; }

    # ── Chặn tốc độ ─────────────────────────────────────────────────────────
    #
    # Zone khai ở `conf.d/chantam-ratelimit.conf` (xem file đó để biết vì sao mọi
    # ngưỡng ở đây CAO HƠN trần của app một cách cố ý). Thiếu file đó thì Nginx
    # không khởi động vì zone chưa khai báo — hỏng ỒN ÀO, đúng ý.

    # Đường xác thực đi zone chặt hơn: đây là nơi người ta dò mật khẩu.
    location ^~ /api/v1/auth/ {
        limit_req zone=chantam_auth burst=10 nodelay;
        limit_conn chantam_conn 100;

        proxy_pass http://127.0.0.1:8085;
        include /etc/nginx/proxy_params;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Socket.io cho chat. KHÔNG đặt limit_req ở đây.
    #
    # Khi WebSocket không nâng cấp được, Socket.io rơi về long-polling và sinh
    # RẤT nhiều lượt request hoàn toàn hợp lệ. Một `limit_req` đặt hồn nhiên sẽ
    # chẹn đúng chat chứ không chẹn kẻ lụt — và người dùng chỉ thấy tin nhắn
    # không tới, không thấy lý do.
    location ^~ /socket.io/ {
        proxy_pass http://127.0.0.1:8085;
        include /etc/nginx/proxy_params;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Idle của WebSocket dài hơn REST rất nhiều: một kết nối đang CHỜ tin
        # nhắn thì không có byte nào chạy qua. 60s như REST sẽ cắt nó mỗi phút,
        # và client phải nối lại liên tục.
        proxy_connect_timeout 10s;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location / {
        limit_req zone=chantam_general burst=60 nodelay;
        limit_conn chantam_conn 100;

        proxy_pass http://127.0.0.1:8085;
        include /etc/nginx/proxy_params;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # Không khai Upgrade/Connection ở đây: khối này phục vụ REST. WebSocket
        # của chat đi qua `location ^~ /socket.io/` ở trên.

        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        client_max_body_size 15m;
    }
}

# Chặn tốc độ (F66) đã khai, nhưng zone nằm ở file RIÊNG:
# `chantam-ratelimit.conf.example` → `/etc/nginx/conf.d/`. `limit_req_zone`,
# `limit_conn_zone` và `map` chỉ hợp lệ trong `http{}`, nên chúng không đặt được
# trong file này.
#
# Cài thiếu file đó thì Nginx TỪ CHỐI khởi động vì zone chưa khai báo. Đó là chủ
# ý: một cấu hình nửa vời phải hỏng lúc `nginx -t`, không phải hỏng lúc có người
# bị chặn oan.
