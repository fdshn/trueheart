{
  "name": "@chantam/service.storage-lib",
  "version": "0.1.0",
  "description": "S3-compatible presigned upload for Chân Tâm",
  "private": true,
  "license": "UNLICENSED",
  "files": ["**/*.js", "**/*.d.ts"],
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "nest build && tsc-alias",
    "dev": "nest build --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "clean": "rimraf tsconfig.build.tsbuildinfo contracts internal index.js index.d.ts index.js.map index.d.ts.map"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@chantam/service.common-lib": "file:../../kernel/common-lib"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.7.3"
  }
}
