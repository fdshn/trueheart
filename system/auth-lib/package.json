{
  "name": "@chantam/service.auth-lib",
  "version": "0.1.0",
  "description": "Xác thực JWT: cấp/kiểm token, băm mật khẩu, guard và decorator",
  "private": true,
  "license": "UNLICENSED",
  "files": ["**/*.js", "**/*.d.ts"],
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "nest build && tsc-alias",
    "clean": "rimraf tsconfig.build.tsbuildinfo consts contracts decorators exceptions guards internal index.js index.d.ts index.js.map index.d.ts.map",
    "dev": "nest build --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest --passWithNoTests"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "fastify": "^5.6.0",
    "reflect-metadata": "^0.2.2"
  },
  "dependencies": {
    "@chantam/service.common-lib": "file:../../kernel/common-lib",
    "@nestjs/jwt": "^11.0.0",
    "bcryptjs": "^3.0.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "fastify": "^5.6.0",
    "jest": "^30.5.1",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.7.3"
  }
}
