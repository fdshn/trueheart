{
  "name": "@chantam/service.changeme-lib",
  "version": "0.1.0",
  "description": "CHANGEME",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "**/*.js",
    "**/*.d.ts"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build && tsc-alias",
    "dev": "nest build --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "clean": "rimraf tsconfig.build.tsbuildinfo consts dto entities exception geo internal models modules persistence utils values index.js index.d.ts index.js.map index.d.ts.map use-case.js use-case.d.ts use-case.js.map use-case.d.ts.map"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/swagger": "^11.2.0",
    "reflect-metadata": "^0.2.2"
  },
  "dependencies": {
    "@chantam/service.common-lib": "file:../common-lib"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/common": "^11.2.5",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "jest": "^29.7.0",
    "reflect-metadata": "^0.2.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.7.3"
  }
}
