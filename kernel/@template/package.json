{
  "name": "@chantam/service.changeme",
  "version": "0.1.0",
  "description": "CHANGEME",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build --builder tsc",
    "dev": "cross-env NODE_ENV=development nest start --watch --builder swc",
    "start": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "docker:generate": "node ../../bin/make-dockerfile.mjs > ./Dockerfile",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "@chantam/service.common-lib": "file:../common-lib",
    "@chantam/service.health-lib": "file:../health-lib",
    "@chantam/service.logger-lib": "file:../logger-lib",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fastify": "^5.6.0",
    "joi": "^17.13.3",
    "nestjs-pino": "^4.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.7",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  }
}
