PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# PostgreSQL phải bật extension PostGIS (docker/postgres/init.sql lo việc này)
DATABASE_URI=postgres://chantam:chantam@localhost:15432/chantam

REDIS_URI=redis://localhost:16379

# Bán kính làm nhiễu toạ độ công khai, tính bằng mét (đặc tả mục 1.3)
GEO_JITTER_RADIUS_METERS=300

# Xác thực — sinh khoá bằng: openssl rand -base64 48
JWT_SECRET=THAY_BANG_KHOA_NGAU_NHIEN_TOI_THIEU_32_KY_TU
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCK_SECONDS=900

# Hạn dùng mã OTP quên mật khẩu, tính bằng giây (120–1800)
OTP_TTL_SECONDS=300

# Ô chọn "Servers" của Swagger UI. Dạng `Nhãn=url`, ngăn bằng dấu phẩy.
#
# ĐỂ TRỐNG khi chạy local: khi đó Swagger tự thêm đúng một mục trỏ về máy đang
# chạy. Khai giá trị ở đây là THAY THẾ hoàn toàn mục đó, không phải thêm vào —
# Swagger UI lấy mục đầu tiên làm mặc định, nên trên server thật mà để localhost
# đứng đầu thì "Try it out" trỏ vào máy người đọc chứ không phải API này.
#
# Trên server thật chỉ khai CHÍNH NÓ, ví dụ:
#   API_SERVERS=Staging=https://api-staging.example.com
# `deploy/bootstrap.sh` tự sinh dòng này từ hostname truyền vào.
API_SERVERS=


# Storage S3-compatible. Local dùng MinIO; production thay bằng Cloudflare R2,
# tuyệt đối không commit access key thật.
STORAGE_ENDPOINT=http://localhost:19000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=chantam-media
STORAGE_ACCESS_KEY_ID=chantam-minio
STORAGE_SECRET_ACCESS_KEY=chantam-minio-secret
STORAGE_PUBLIC_BASE_URL=http://localhost:19000/chantam-media

# Gốc URL web công khai, dùng dựng link chia sẻ hồ sơ (`/u/<username>`).
# Bỏ trống thì API trả shareUrl = null thay vì đoán một domain chưa tồn tại.
WEB_PUBLIC_BASE_URL=

# Khoá mã hoá secret do Admin cấu hình (mật khẩu SMTP, API key Zalo...).
# 32 byte base64, sinh bằng: openssl rand -base64 32
# Khoá nằm Ở ĐÂY, ciphertext nằm trong database — đọc được dump cũng chưa lấy
# được mật khẩu. Bỏ trống thì không lưu được secret nào (fail closed).
CONFIG_ENCRYPTION_KEY=

# OTP email provider (CHƯA bật gửi thật). Chỉ khai From identity để chuẩn bị;
# có giá trị không làm LoggingOtpSender thành configured. Adapter/vendor/key/domain
# verification + delivery test được theo dõi tại docs/plan/DEFERRED.md.
OTP_EMAIL_FROM_ADDRESS=
OTP_EMAIL_FROM_NAME=Chân Tâm

# ─────────────────────────────────────────────────────────────────────────────
# Allowlist tạm theo username. M6 thay cả ba bằng role thật trong Admin CMS.
#
# Ở LOCAL nên để đúng giá trị dưới đây: `demo-kiem-duyet` là tài khoản do
# `npm run seed:demo` tạo, và `scripts/smoke-test.sh` đăng nhập bằng nó để duyệt
# bài. Bỏ trống thì smoke test đỏ 3 phép kiểm với lỗi 403 — không phải vì code
# sai mà vì thiếu đúng dòng này.
#
# Trên PRODUCTION thì để TRỐNG: quyền vận hành phải đi qua Admin CMS, không qua
# biến môi trường.

# Duyệt/từ chối bài đăng, và duyệt yêu cầu chuyển vật phẩm về điểm từ thiện.
POST_OPERATOR_USERNAMES=demo-kiem-duyet

# Chạy đánh giá chu kỳ duy trì hạng (`POST /ranks/maintenance/evaluate`).
RANK_OPERATOR_USERNAMES=demo-kiem-duyet

# Tạo/sửa danh mục động (F14).
CATEGORY_ADMIN_USERNAMES=demo-kiem-duyet

# Chỉ dùng MỘT LẦN để gán SUPER_ADMIN cho tài khoản đã tồn tại; sau đó xoá giá
# trị này. Để nguyên là mỗi lần khởi động lại cấp quyền cao nhất cho username đó.
ADMIN_BOOTSTRAP_USERNAMES=

# ─────────────────────────────────────────────────────────────────────────────
# Chỉ dùng cho script, không phải cấu hình service

# Đích mà `npm run test:chat-e2e` gọi tới. Bỏ trống thì mặc định
# http://localhost:3000. Script này cần service ĐANG CHẠY.
CORE_URL=

# `npm run seed:demo` tự đặt biến này; không cần khai ở đây. Seed từ chối chạy
# khi biến không bật, để không ai vô tình chèn dữ liệu demo vào production.
# SEED_DEMO_DATA=true
