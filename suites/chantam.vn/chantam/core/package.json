{
  "name": "@chantam.vn/chantam.core",
  "version": "0.1.0",
  "description": "Service lõi của nền tảng Chân Tâm",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build --builder tsc",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "dev": "cross-env NODE_ENV=development nest start --watch --builder swc",
    "docker:build": "cross-var docker build ../../../.. -f Dockerfile -t chantam/core:$npm_package_version",
    "docker:generate": "node ../../../../bin/make-dockerfile.mjs > ./Dockerfile",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "migration:generate": "node ../../../../bin/generate-migration.mjs",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:show": "npm run typeorm -- migration:show",
    "prebuild": "rimraf dist",
    "start": "node dist/main",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "typeorm": "typeorm-ts-node-commonjs --dataSource src/infrastructure/persistence/data-source.ts"
  },
  "dependencies": {
    "@chantam.vn/chantam.core-lib": "file:../core-lib",
    "@chantam/service.common-lib": "file:../../../../kernel/common-lib",
    "@chantam/service.health-lib": "file:../../../../kernel/health-lib",
    "@chantam/service.logger-lib": "file:../../../../kernel/logger-lib",
    "@chantam/service.persistency-lib": "file:../../../../kernel/persistency-lib",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fastify": "^5.6.0",
    "joi": "^17.13.3",
    "nestjs-pino": "^4.4.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-mixer": "^6.0.4",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "cross-env": "^10.1.0",
    "cross-var": "^1.1.0",
    "dotenv": "^16.4.7",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
