{
  "name": "@chantam.vn/chantam.core",
  "version": "0.1.0",
  "description": "Service lõi của nền tảng Chân Tâm",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build --builder tsc",
    "clean": "rimraf dist tsconfig.build.tsbuildinfo",
    "debug": "cross-env NODE_ENV=development nest start --debug --watch",
    "dev": "cross-env NODE_ENV=development nest start --watch --builder swc",
    "docker:build": "cross-var docker build ../../../.. -f Dockerfile -t chantam/core:$npm_package_version",
    "docker:generate": "node ../../../../bin/make-dockerfile.mjs > ./Dockerfile",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "migration:generate": "node ../../../../bin/generate-migration.mjs",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:backfill-check": "ts-node -r tsconfig-paths/register test/posts-backfill.check.ts",
    "test:chat-e2e": "ts-node -r tsconfig-paths/register test/chat-e2e.check.ts",
    "test:chat-paging": "ts-node -r tsconfig-paths/register test/chat-paging.check.ts",
    "test:config-inventory": "ts-node -r tsconfig-paths/register test/config-inventory.check.ts",
    "test:entitlement-inventory": "ts-node -r tsconfig-paths/register test/entitlement-inventory.check.ts",
    "test:location-privacy": "ts-node -r tsconfig-paths/register test/location-privacy.check.ts",
    "test:chat-access": "ts-node -r tsconfig-paths/register test/chat-access.check.ts",
    "test:post-status": "ts-node -r tsconfig-paths/register test/post-status.check.ts",
    "test:gift-points": "ts-node -r tsconfig-paths/register test/gift-points.check.ts",
    "test:handover": "ts-node -r tsconfig-paths/register test/handover.check.ts",
    "test:chat-purge": "ts-node -r tsconfig-paths/register test/chat-purge.check.ts",
    "test:feed-foundation": "ts-node -r tsconfig-paths/register test/feed-foundation.check.ts",
    "test:feed-reactions": "ts-node -r tsconfig-paths/register test/feed-reactions.check.ts",
    "test:feed-comments": "ts-node -r tsconfig-paths/register test/feed-comments.check.ts",
    "test:feed-media": "ts-node -r tsconfig-paths/register test/feed-media.check.ts",
    "test:feed-shares": "ts-node -r tsconfig-paths/register test/feed-shares.check.ts",
    "test:redemption": "ts-node -r tsconfig-paths/register test/redemption.check.ts",
    "test:reviews": "ts-node -r tsconfig-paths/register test/reviews.check.ts",
    "typecheck:checks": "tsc --noEmit -p test/tsconfig.json",
    "test:point-economy": "ts-node -r tsconfig-paths/register test/point-economy.check.ts",
    "test:gift-rewards": "ts-node -r tsconfig-paths/register test/gift-rewards.check.ts",
    "test:rank-balance": "ts-node -r tsconfig-paths/register test/rank-balance.check.ts",
    "test:reminders": "ts-node -r tsconfig-paths/register test/reminders.check.ts",
    "test:selection": "ts-node -r tsconfig-paths/register test/selection.check.ts",
    "test:group": "ts-node -r tsconfig-paths/register test/group.check.ts",
    "test:category": "ts-node -r tsconfig-paths/register test/category.check.ts",
    "test:referral": "ts-node -r tsconfig-paths/register test/referral.check.ts",
    "test:media-policy": "ts-node -r tsconfig-paths/register test/media-policy.check.ts",
    "test:phone-identity": "ts-node -r tsconfig-paths/register test/phone-identity.check.ts",
    "test:user-activity": "ts-node -r tsconfig-paths/register test/user-activity.check.ts",
    "test:feed-merge": "ts-node -r tsconfig-paths/register test/feed-merge.check.ts",
    "test:request-lifecycle": "ts-node -r tsconfig-paths/register test/request-lifecycle.check.ts",
    "notification:purge": "ts-node -r tsconfig-paths/register src/infrastructure/cli/notification-purge.cli.ts",
    "notification:purge:built": "node dist/infrastructure/cli/notification-purge.cli.js",
    "test:notification": "ts-node -r tsconfig-paths/register test/notification.check.ts",
    "test:returning": "ts-node -r tsconfig-paths/register test/returning-contract.check.ts",
    "test:lifecycle": "ts-node -r tsconfig-paths/register test/post-lifecycle.check.ts",
    "test:concurrency": "ts-node -r tsconfig-paths/register test/gift-request-concurrency.check.ts",
    "migration:show": "npm run typeorm -- migration:show",
    "rank:evaluate": "ts-node -r tsconfig-paths/register src/infrastructure/cli/rank-evaluate.cli.ts",
    "rank:evaluate:built": "node dist/infrastructure/cli/rank-evaluate.cli.js",
    "point:reconcile": "ts-node -r tsconfig-paths/register src/infrastructure/cli/point-reconcile.cli.ts",
    "point:reconcile:built": "node dist/infrastructure/cli/point-reconcile.cli.js",
    "post:expire": "ts-node -r tsconfig-paths/register src/infrastructure/cli/post-expire.cli.ts",
    "post:expire:built": "node dist/infrastructure/cli/post-expire.cli.js",
    "accuracy:reconcile": "ts-node -r tsconfig-paths/register src/infrastructure/cli/accuracy-reconcile.cli.ts",
    "gift:settle-rewards": "ts-node -r tsconfig-paths/register src/infrastructure/cli/gift-settle-rewards.cli.ts",
    "notify:reminders": "ts-node -r tsconfig-paths/register src/infrastructure/cli/notify-reminders.cli.ts",
    "selection:auto-select": "ts-node -r tsconfig-paths/register src/infrastructure/cli/selection-auto-select.cli.ts",
    "selection:auto-select:built": "node dist/infrastructure/cli/selection-auto-select.cli.js",
    "notify:reminders:built": "node dist/infrastructure/cli/notify-reminders.cli.js",
    "notify:lunar": "ts-node -r tsconfig-paths/register src/infrastructure/cli/notify-lunar.cli.ts",
    "notify:lunar:built": "node dist/infrastructure/cli/notify-lunar.cli.js",
    "notify:broadcast": "ts-node -r tsconfig-paths/register src/infrastructure/cli/notify-broadcast.cli.ts",
    "notify:broadcast:built": "node dist/infrastructure/cli/notify-broadcast.cli.js",
    "gift:settle-rewards:built": "node dist/infrastructure/cli/gift-settle-rewards.cli.js",
    "accuracy:reconcile:built": "node dist/infrastructure/cli/accuracy-reconcile.cli.js",
    "feed:reconcile-counts": "ts-node -r tsconfig-paths/register src/infrastructure/cli/feed-reconcile-counts.cli.ts",
    "feed:reconcile-counts:built": "node dist/infrastructure/cli/feed-reconcile-counts.cli.js",
    "media:sweep-orphans": "ts-node -r tsconfig-paths/register src/infrastructure/cli/media-sweep-orphans.cli.ts",
    "media:sweep-orphans:built": "node dist/infrastructure/cli/media-sweep-orphans.cli.js",
    "chat:purge": "ts-node -r tsconfig-paths/register src/infrastructure/cli/chat-purge.cli.ts",
    "chat:purge:built": "node dist/infrastructure/cli/chat-purge.cli.js",
    "transaction:autocomplete": "ts-node -r tsconfig-paths/register src/infrastructure/cli/transaction-autocomplete.cli.ts",
    "transaction:autocomplete:built": "node dist/infrastructure/cli/transaction-autocomplete.cli.js",
    "seed:demo": "cross-env SEED_DEMO_DATA=true ts-node -r tsconfig-paths/register src/infrastructure/persistence/seeds/seed-demo-data.cli.ts",
    "seed:demo:built": "cross-env SEED_DEMO_DATA=true node dist/infrastructure/persistence/seeds/seed-demo-data.cli.js",
    "prebuild": "rimraf dist",
    "start": "node dist/main",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:watch": "jest --watch",
    "typeorm": "typeorm-ts-node-commonjs --dataSource src/infrastructure/persistence/data-source.ts",
    "test:srs-endpoints": "ts-node -r tsconfig-paths/register test/srs-endpoint-gaps.check.ts",
    "test:check-in": "ts-node -r tsconfig-paths/register test/check-in-streak.check.ts",
    "test:affiliate": "ts-node -r tsconfig-paths/register test/affiliate-engine.check.ts",
    "test:allocation": "ts-node -r tsconfig-paths/register test/allocation-policy.check.ts",
    "test:home-campaign": "ts-node -r tsconfig-paths/register test/home-campaign.check.ts",
    "test:blog": "ts-node -r tsconfig-paths/register test/blog.check.ts",
    "test:dashboard": "ts-node -r tsconfig-paths/register test/dashboard-kpi.check.ts",
    "test:lunar": "ts-node -r tsconfig-paths/register test/lunar.check.ts",
    "test:broadcast": "ts-node -r tsconfig-paths/register test/broadcast.check.ts"
  },
  "dependencies": {
    "@chantam.vn/chantam.core-lib": "file:../core-lib",
    "@chantam/service.auth-lib": "file:../../../../system/auth-lib",
    "@chantam/service.common-lib": "file:../../../../kernel/common-lib",
    "@chantam/service.health-lib": "file:../../../../kernel/health-lib",
    "@chantam/service.logger-lib": "file:../../../../kernel/logger-lib",
    "@chantam/service.persistency-lib": "file:../../../../kernel/persistency-lib",
    "@chantam/service.storage-lib": "file:../../../../system/storage-lib",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.2.5",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.2.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fastify": "^5.6.0",
    "ioredis": "^5.4.2",
    "joi": "^17.13.3",
    "nestjs-pino": "^4.4.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sanitize-html": "^2.18.0",
    "socket.io": "^4.8.3",
    "ts-mixer": "^6.0.4",
    "typeorm": "^0.3.27"
